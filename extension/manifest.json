{
  "manifest_version": 3,
  "name": "DouyinDataReview 推荐流过滤",
  "version": "1.0.0",
  "description": "按 DouyinDataReview 里设的词条，在抖音网页的推荐进页面之前拿掉不想看的视频。词条、过滤方式和记录都在应用里管。",
  "key": "",
  "icons": { "128": "icon-128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["filter.js", "page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
