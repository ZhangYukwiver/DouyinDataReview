{
  "manifest_version": 3,
  "name": "DouyinDataReview 推荐流过滤",
  "version": "1.4.0",
  "description": "在抖音网页悬浮窗编辑推荐词和屏蔽词、查看插入和屏蔽记录，或用 DouyinDataReview 下载当前视频。",
  "key": "",
  "icons": { "128": "icon-128.png" },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.douyin.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["filter.js", "picks.js", "page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["panel.js", "bridge.js"],
      "run_at": "document_start"
    }
  ]
}
