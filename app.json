{
  "expo": {
    "name": "DouyinDataReview",
    "slug": "douyin-content-insights",
    "version": "1.32.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "contentinsights",
    "icon": "./build/icon.png",
    "android": {
      "package": "com.zhangyukwiver.douyindatareview.proof",
      "versionCode": 3,
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "ios": {
      "infoPlist": {
        "NSAllowsLocalNetworking": true,
        "NSLocalNetworkUsageDescription": "连接电脑上的本地抖音记录采集服务。"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./build/icon-48.png"
    }
  }
}
