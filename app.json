{
  "expo": {
    "name": "内容数据工作台",
    "slug": "douyin-content-insights",
    "version": "0.1.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "contentinsights",
    "icon": "./build/icon.png",
    "android": {
      "usesCleartextTraffic": true
    },
    "ios": {
      "infoPlist": {
        "NSAllowsLocalNetworking": true,
        "NSLocalNetworkUsageDescription": "连接电脑上的本地抖音记录采集服务。"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./build/icon-48.png"
    }
  }
}
