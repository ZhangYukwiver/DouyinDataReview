{
  "name": "douyin-content-insights-mobile",
  "version": "0.1.8",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "collector": "node collector/server.mjs",
    "direct:setup": "node scripts/setup-direct-signer.mjs",
    "direct:check": "node collector/directHistory.mjs --check-signer",
    "app:mac": "npm run build:icons && osacompile -s -o '抖音年度回顾.app' scripts/macos-launcher.applescript && plutil -replace CFBundleIdentifier -string local.douyin.annual-recap '抖音年度回顾.app/Contents/Info.plist' && plutil -replace NSDocumentsFolderUsageDescription -string '读取同目录中的本地应用代码与年度回顾数据。' '抖音年度回顾.app/Contents/Info.plist' && cp build/icon.icns '抖音年度回顾.app/Contents/Resources/applet.icns' && plutil -remove CFBundleIconName '抖音年度回顾.app/Contents/Info.plist' && codesign --force --deep --sign - '抖音年度回顾.app'",
    "build:icons": "node scripts/build-icons.mjs",
    "watch:process": "node scripts/process-watchdog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:story-frames": "node scripts/story-visual-regression.mjs",
    "prebuild:web": "npm run build:icons && npm run sync:story",
    "build:web": "expo export --platform web",
    "desktop": "npm run build:web && electron desktop/main.mjs",
    "desktop:pack": "npm run build:web && npm run direct:setup && electron-builder --win dir --publish never",
    "desktop:build": "npm run build:web && npm run direct:setup && electron-builder --win nsis --publish never",
    "sync:story": "node scripts/sync-story.mjs",
    "desktop:build:mac": "npm run build:web && npm run direct:setup && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "electron-updater": "6.8.9",
    "expo": "~57.0.11",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "fflate": "^0.8.2",
    "lucide-react-native": "^1.30.0",
    "playwright-core": "^1.62.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.34.4",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.zhangyukwiver.contentinsights",
    "productName": "内容数据工作台",
    "extraMetadata": {
      "main": "desktop/main.mjs"
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ZhangYukwiver",
      "repo": "DouyinDataReview",
      "releaseType": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "desktop/**/*",
      "collector/**/*",
      "dist/**/*",
      "build/icon.png",
      "node_modules/playwright-core/**/*",
      "package.json",
      "!**/*.test.mjs",
      "!collector/fixtures/**",
      "!node_modules/!(playwright-core|electron-updater|builder-util-runtime|debug|ms|fs-extra|graceful-fs|jsonfile|universalify|js-yaml|argparse|sax|lazy-val|lodash.escaperegexp|lodash.isequal|semver|tiny-typed-emitter)/**"
    ],
    "asar": true,
    "asarUnpack": [
      "collector/directSignerRunner.cjs",
      "node_modules/playwright-core/**/*"
    ],
    "extraResources": [
      {
        "from": ".local-data/direct-signer",
        "to": "direct-signer",
        "filter": [
          "LICENSE",
          "lib/runtime/bdms/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ContentInsights-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "内容数据工作台",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "afterPack": "scripts/mac-adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "ContentInsights-${version}-${arch}.${ext}"
    }
  }
}
